# Editor settings shared by everyone: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab

[*.{py,toml}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md,js,html}]
indent_style = space
indent_size = 2
